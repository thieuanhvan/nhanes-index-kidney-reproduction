// I139 Phụ lục A, họ D1 TyG và dẫn xuất, DAG B. Sinh bằng tools/build_dag_i139.py từ bảng 5.2 của
// prereg_i139_v6_vi.md (sha256 72db630ce54c3d65d90c8d175aaf0eac10145d967020fc802387d147fd25ca21). Bảng là nguồn duy nhất; nếu khác nhau thì bảng đúng.
// Mã hoá vai trò: G (và T có B+ ở DAG B) = gây nhiễu, vào bộ hiệu chỉnh; T/P ngoài bộ = chỉ yếu tố nguy cơ của kết cục;
// K-C = thành phần (-> chỉ số); K-M = trung gian/hậu duệ phơi nhiễm; K-O = hậu duệ kết cục; K-X = va chạm.
// DAG ở mức họ chỉ số, chỉ vẽ cạnh quyết định bộ hiệu chỉnh; cạnh giữa các hiệp biến không vẽ.
dag {
Index [exposure,pos="0.00,-0.00"]
Kidney_disease [outcome,pos="10.00,-0.00"]
Age_Sex [adjusted,pos="1.25,-4.20"]  // G
Race_ethnicity [adjusted,pos="3.75,-4.20"]  // G
Education_PIR [adjusted,pos="6.25,-4.20"]  // G
Smoking [adjusted,pos="8.75,-4.20"]  // G
Alcohol [adjusted,pos="1.25,-3.00"]  // T B+ | B+
Physical_activity [adjusted,pos="3.75,-3.00"]  // T B+ | B+
BMI_waist [adjusted,pos="6.25,-3.00"]  // T B+ | B+ (K-C ở TyG-BMI, TyG-WC, TyG-WHtR)
Diagnosed_diabetes [pos="3.00,1.30"]  // K-M
Glycaemia_HbA1c_insulin [pos="5.00,1.30"]  // K-M | hoặc K-M
Diagnosed_hypertension [pos="7.00,1.30"]  // K-M
Measured_BP [pos="4.94,3.80"]  // K-O
Lipid_lowering_drugs [adjusted,pos="8.75,-3.00"]  // T B+ | B+
Diabetes_drugs [pos="3.17,-1.60"]  // T
Antihypertensive_drugs [pos="6.50,-1.60"]  // T
HDL_LDL_TC [pos="9.83,-1.60"]  // T | (HDL ghi là hậu duệ khả dĩ của kháng insulin)
CRP_WBC [pos="4.75,2.60"]  // T
Uric_acid [pos="6.81,3.80"]  // K-O
Kidney_markers [pos="8.69,3.80"]  // K-O
CVD [pos="10.56,3.80"]  // K-X
NHANES_cycle [pos="9.25,2.60"]  // P
Age_Sex -> Index
Age_Sex -> Kidney_disease
Alcohol -> Index
Alcohol -> Kidney_disease
Antihypertensive_drugs -> Kidney_disease
BMI_waist -> Index
BMI_waist -> Kidney_disease
CRP_WBC -> Kidney_disease
Diabetes_drugs -> Kidney_disease
Diagnosed_diabetes -> Kidney_disease
Diagnosed_hypertension -> Kidney_disease
Education_PIR -> Index
Education_PIR -> Kidney_disease
Glycaemia_HbA1c_insulin -> Kidney_disease
HDL_LDL_TC -> Kidney_disease
Index -> CVD
Index -> Diagnosed_diabetes
Index -> Diagnosed_hypertension
Index -> Glycaemia_HbA1c_insulin
Index -> Kidney_disease
Kidney_disease -> CVD
Kidney_disease -> Kidney_markers
Kidney_disease -> Measured_BP
Kidney_disease -> Uric_acid
Lipid_lowering_drugs -> Index
Lipid_lowering_drugs -> Kidney_disease
NHANES_cycle -> Kidney_disease
Physical_activity -> Index
Physical_activity -> Kidney_disease
Race_ethnicity -> Index
Race_ethnicity -> Kidney_disease
Smoking -> Index
Smoking -> Kidney_disease
}
