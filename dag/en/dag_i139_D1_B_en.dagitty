// I139 Appendix A, family D1 TyG and derivatives, DAG B. Built by tools/build_dag_i139_en.py from table 5.2 of
// prereg_i139_v7_en.md (sha256 cf05a9e110595ff68f8fe4e54e0bc3472de75f631621df5e9a36f62310ed99be). English rendering of the registered DAG (dag/, OSF egjy3).
// Roles: G (and T with B+ in DAG B) = confounder, in the adjustment set; T/P outside the set = risk factor of the outcome only;
// K-C = component (-> index); K-M = mediator or descendant of the exposure; K-O = descendant of the outcome; K-X = collider.
// Family-level DAG: only edges that decide the adjustment set are drawn; edges between covariates are not drawn.
dag {
Index [exposure,pos="0.00,-0.00"]
Kidney_disease [outcome,pos="10.00,-0.00"]
Age_Sex [adjusted,pos="1.25,-4.20"]  // G
Race_ethnicity [adjusted,pos="3.75,-4.20"]  // G
Education_PIR [adjusted,pos="6.25,-4.20"]  // G
Smoking [adjusted,pos="8.75,-4.20"]  // G
Alcohol [adjusted,pos="1.25,-3.00"]  // T B+ | B+
Physical_activity [adjusted,pos="3.75,-3.00"]  // T B+ | B+
BMI_waist [adjusted,pos="6.25,-3.00"]  // T B+ | B+ (K-C in TyG-BMI, TyG-WC, TyG-WHtR)
Diagnosed_diabetes [pos="3.00,1.30"]  // K-M
Glycaemia_HbA1c_insulin [pos="5.00,1.30"]  // K-M | or K-M
Diagnosed_hypertension [pos="7.00,1.30"]  // K-M
Measured_BP [pos="4.94,3.80"]  // K-O
Lipid_lowering_drugs [adjusted,pos="8.75,-3.00"]  // T B+ | B+
Diabetes_drugs [pos="3.17,-1.60"]  // T
Antihypertensive_drugs [pos="6.50,-1.60"]  // T
HDL_LDL_TC [pos="9.83,-1.60"]  // T | (HDL recorded as a plausible descendant of insulin resistance)
CRP_WBC [pos="4.75,2.60"]  // T
Uric_acid [pos="6.81,3.80"]  // K-O
Kidney_markers [pos="8.69,3.80"]  // K-O
CVD [pos="10.56,3.80"]  // K-X
NHANES_cycle [pos="9.25,2.60"]  // P
