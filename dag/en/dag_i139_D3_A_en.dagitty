// I139 Appendix A, family D3 diet and lifestyle, DAG A. Built by tools/build_dag_i139_en.py from table 5.2 of
// prereg_i139_v7_en.md (sha256 cf05a9e110595ff68f8fe4e54e0bc3472de75f631621df5e9a36f62310ed99be). English rendering of the registered DAG (dag/, OSF egjy3).
// Roles: G (and T with B+ in DAG B) = confounder, in the adjustment set; T/P outside the set = risk factor of the outcome only;
// K-C = component (-> index); K-M = mediator or descendant of the exposure; K-O = descendant of the outcome; K-X = collider.
// Family-level DAG: only edges that decide the adjustment set are drawn; edges between covariates are not drawn.
dag {
Index [exposure,pos="0.00,-0.00"]
Kidney_disease [outcome,pos="10.00,-0.00"]
Age_Sex [adjusted,pos="1.67,-4.20"]  // G
Race_ethnicity [adjusted,pos="5.00,-4.20"]  // G
Education_PIR [adjusted,pos="8.33,-4.20"]  // G
Smoking [adjusted,pos="1.67,-3.00"]  // G
Alcohol [pos="2.75,-1.60"]  // T B+ | B+ (K-C if in the index)
Physical_activity [pos="5.25,-1.60"]  // T B+ | B+ (K-C if in the index)
BMI_waist [pos="3.50,1.30"]  // K-M
Diagnosed_diabetes [adjusted,pos="5.00,-3.00"]  // G
Glycaemia_HbA1c_insulin [pos="6.50,1.30"]  // K-M | (as D2)
Diagnosed_hypertension [adjusted,pos="8.33,-3.00"]  // G
Measured_BP [pos="4.94,3.80"]  // K-O
Lipid_lowering_drugs [pos="7.75,-1.60"]  // T
Diabetes_drugs [pos="10.25,-1.60"]  // T
Antihypertensive_drugs [pos="3.62,2.60"]  // T
HDL_LDL_TC [pos="5.88,2.60"]  // T
CRP_WBC [pos="8.12,2.60"]  // T
Uric_acid [pos="6.81,3.80"]  // K-O
Kidney_markers [pos="8.69,3.80"]  // K-O
CVD [pos="10.56,3.80"]  // K-X
NHANES_cycle [pos="10.38,2.60"]  // P
